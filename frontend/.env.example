# Base URL of the core API. Defaults to http://localhost:8000 if unset.
VITE_API_BASE_URL=http://localhost:8000

# WebSocket URL of the execution-service. Defaults to ws://localhost:8100/ws/execution if unset.
VITE_EXECUTION_WS_URL=ws://localhost:8100/ws/execution

# Set to "false" to disable the Python/R/Data Viz labs' free-form code
# execution (SQL Lab and Statistics Lab are unaffected — neither needs the
# sandbox). Use this for a public launch before the execution-service runs
# behind a real container sandbox (gVisor/Firecracker) instead of this dev
# build's resource-limited subprocess. Any other value, or leaving it
# unset, keeps the labs on.
VITE_CODE_LABS_ENABLED=true
