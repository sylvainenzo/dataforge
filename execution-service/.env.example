# Must match the Core API's JWT_SECRET exactly — this service verifies the
# same access tokens the Core API issues, independently, without calling
# back to it (see app/auth.py).
JWT_SECRET=replace-me-must-match-backend/.env

REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+psycopg://user@localhost:5432/dataforge_dev
CORS_ORIGINS=["http://localhost:5180"]
