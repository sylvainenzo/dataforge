# Copy to .env and adjust for your environment. Never commit the real .env file.
DATABASE_URL=postgresql+psycopg://user@localhost:5432/dataforge_dev
REDIS_URL=redis://localhost:6379/0

# Generate your own: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-generated-secret
SESSION_SECRET=replace-me-with-a-different-generated-secret

CORS_ORIGINS=["http://localhost:5180"]
COOKIE_SECURE=false

# OAuth — leave unset to disable Google/GitHub login; email/password still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
SQL_LAB_DATABASE_URL=postgresql+psycopg://sql_lab_readonly:REPLACE_ME@localhost:5432/dataforge_sql_lab
